{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".gen/src",
    "outDir": ".gen/out404",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": false,
    "removeComments": false,
    "baseUrl": ".gen/src",
    "paths": {
