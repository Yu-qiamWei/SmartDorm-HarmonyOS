      "@kit.AbilityKit": ["__stub/kit_abilitykit"],
      "@kit.BasicServicesKit": ["__stub/kit_basicservices"],
      "@kit.ArkTS": ["__stub/kit_arkts"],
      "@kit.CoreFileKit": ["__stub/kit_corefile"]
    }
  },
  "files": [
    ".gen/src/service/ExportService.ts"
  ]
}
