{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".gen/src",
    "outDir": ".gen/out",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true,
    "removeComments": false
  },
  "files": [
    ".gen/src/store/StorageKeys.ts",
    ".gen/src/store/WriteQueue.ts",
    ".gen/src/store/Serializer.ts",
    ".gen/src/store/SchemaMigration.ts",
    ".gen/src/store/StorageDiagnostics.ts"
  ]
}
