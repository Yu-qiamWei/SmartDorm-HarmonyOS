{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".gen/src",
    "outDir": ".gen/out",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true,
    "removeComments": false,
    "baseUrl": ".gen/src",
    "paths": {
      "@kit.ArkData": ["__stub/kit_arkdata"],
      "@kit.AbilityKit": ["__stub/kit_abilitykit"],
      "@kit.BasicServicesKit": ["__stub/kit_basicservices"],
      "@kit.ArkTS": ["__stub/kit_arkts"]
    }
  },
  "files": [
    ".gen/src/store/StorageKeys.ts",
    ".gen/src/store/WriteQueue.ts",
    ".gen/src/store/Serializer.ts",
    ".gen/src/store/SchemaMigration.ts",
    ".gen/src/store/StorageDiagnostics.ts",
    ".gen/src/store/AppDataRepository.ts"
  ]
}
